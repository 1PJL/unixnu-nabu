+/*
+ * Built-in IOSurface for NABU.
+ *
+ * Apple's IOSurface kext is closed. IOSurface.framework (iOS 16.7) finds
+ * IOServiceNameMatching("IOCoreSurfaceRoot"), opens it with type 0 and
+ * talks to the user client below:
+ *
+ *   sel 13  limits: struct out 0x18, u16 at +0x16 must be 1 (ABI version),
+ *           +0 offset alignment mask, +4 bytes-per-row alignment mask
+ *   sel 0   create: scalar [parent id], struct in = serialized property
+ *           dictionary (binary or XML), struct out = lock result (0xa68)
+ *   sel 4   lookup by id: scalar [id], struct out = lock result
+ *   sel 34  lookup by mach port: scalar [port name], struct out = lock result
+ *   sel 35  create mach port: scalars [id, options], scalar out [port name]
+ *   traps   0/1 use count +/- (id, category), 2 lock / 3 unlock
+ *           (id, options, &seed), 4/5 release (id)
+ *
+ * The lock result tells the library where the surface lives in the
+ * caller's address space: +0 pixels, +8 shared state page (registry id,
+ * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
+ * nabu_surface_fill_result). Every surface is wired kernel memory mapped
+ * into each task that creates or looks it up; mappings are counted per
+ * client and dropped on release or close.
+ *
+ * Values, notifications, accelerators and shared events are accepted and
+ * ignored (logged once per selector).
+ */
+#include "NabuSurface.h"
+
+#if defined(NABU)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <sys/proc.h>
+
+enum {
+	kNabuSurfaceCreate             = 0,
+	kNabuSurfaceLookup             = 4,
+	kNabuSurfaceLimits             = 13,
+	kNabuSurfaceLookupFromPort     = 34,
+	kNabuSurfaceCreatePort         = 35,
+};
+
+enum {
+	kNabuSurfaceTrapIncrementUse   = 0,
+	kNabuSurfaceTrapDecrementUse   = 1,
+	kNabuSurfaceTrapLock           = 2,
+	kNabuSurfaceTrapUnlock         = 3,
+	kNabuSurfaceTrapRelease        = 4,
+	kNabuSurfaceTrapReleaseFailed  = 5,
+};
+
+#define NABU_SURFACE_RESULT_SIZE       0xa68
+#define NABU_SURFACE_MAX_ID            4096
+#define NABU_SURFACE_MAX_DIM           16384
+#define NABU_SURFACE_MAX_ALLOC         (256u << 20)
+#define NABU_SURFACE_MAX_PROPS         (64u << 10)
+#define NABU_SURFACE_ROW_ALIGN         64
+#define NABU_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
+#define NABU_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define kIOSurfaceLockReadOnly          0x1
+
+static IOLock       *nabu_surface_lock;
+static NabuSurface *nabu_surface_table[NABU_SURFACE_MAX_ID];
+static uint32_t      nabu_surface_users[NABU_SURFACE_MAX_ID];
+static uint32_t      nabu_surface_next_id = 1;
+static uint32_t      nabu_surface_creates_logged;
+static uint64_t      nabu_surface_wired;       /* bytes of buffer surfaces */
+#define NABU_SURFACE_WIRED_MAX         (1536ull << 20)
+
+OSDefineMetaClassAndStructors(NabuSurface, OSObject);
+
+void
+NabuSurface::free()
+{
+	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&nabu_surface_wired);
+	}
+	OSSafeReleaseNULL(kernelMap);
+	OSSafeReleaseNULL(memory);
+	OSSafeReleaseNULL(state);
+	OSObject::free();
+}
+
+uintptr_t
+NabuSurface::kernelAddress()
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	IOLockLock(nabu_surface_lock);
+	if (kernelMap == NULL && memory != NULL) {
+		kernelMap = memory->map(kIOMapWriteCombineCache);
+	}
+	IOLockUnlock(nabu_surface_lock);
+	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;
+}
+
+static uint32_t *
+nabu_surface_seed(NabuSurface *s)
+{
+	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + NABU_SURFACE_STATE_SEED);
+}
+
+/*
+ * Give the surface an id and a table slot; the table holds one retain and a
+ * user count (creators, client mappings, kernel holders). Lock held.
+ */
+static bool
+nabu_surface_insert_locked(NabuSurface *s)
+{
+	for (uint32_t n = 0; n < NABU_SURFACE_MAX_ID - 1; n++) {
+		uint32_t id = nabu_surface_next_id;
+		nabu_surface_next_id = id + 1 < NABU_SURFACE_MAX_ID ? id + 1 : 1;
+		if (nabu_surface_table[id] == NULL) {
+			s->id = id;
+			s->retain();
+			nabu_surface_table[id] = s;
+			nabu_surface_users[id] = 1;
+			*(uint64_t *)s->state->getBytesNoCopy() = id;   /* registry id */
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Add a user to a surface that may have left the table (port lookups). */
+static bool
+nabu_surface_get(NabuSurface *s)
+{
+	bool ok = true;
+	IOLockLock(nabu_surface_lock);
+	if (nabu_surface_table[s->id] == s) {
+		nabu_surface_users[s->id]++;
+	} else if (nabu_surface_table[s->id] == NULL) {
+		s->retain();
+		nabu_surface_table[s->id] = s;
+		nabu_surface_users[s->id] = 1;
+	} else {
+		ok = false;
+	}
+	IOLockUnlock(nabu_surface_lock);
+	return ok;
+}
+
+/* Drop a user; the last one removes the surface from the table. */
+static void
+nabu_surface_put(NabuSurface *s)
+{
+	bool drop = false;
+	IOLockLock(nabu_surface_lock);
+	if (nabu_surface_table[s->id] == s && --nabu_surface_users[s->id] == 0) {
+		nabu_surface_table[s->id] = NULL;
+		drop = true;
+	}
+	IOLockUnlock(nabu_surface_lock);
+	if (drop) {
+		s->release();
+	}
+}
+
+NabuSurface *
+nabu_surface_copy(uint32_t id)
+{
+	NabuSurface *s = NULL;
+	if (id == 0 || id >= NABU_SURFACE_MAX_ID || nabu_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(nabu_surface_lock);
+	s = nabu_surface_table[id];
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(nabu_surface_lock);
+	return s;
+}
+
+/* The table lock; the framebuffer may publish a surface before the root starts. */
+static void
+nabu_surface_init_lock(void)
+{
+	if (nabu_surface_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &nabu_surface_lock)) {
+			IOLockFree(lock);
+		}
+	}
+}
+
+static NabuSurface *
+nabu_surface_alloc(void)
+{
+	nabu_surface_init_lock();
+	NabuSurface *s = OSTypeAlloc(NabuSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return NULL;
+	}
+	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	if (s->state == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(s->state->getBytesNoCopy(), page_size);
+	return s;
+}
+
+static bool
+nabu_surface_publish(NabuSurface *s)
+{
+	bool ok;
+	IOLockLock(nabu_surface_lock);
+	ok = nabu_surface_insert_locked(s);
+	IOLockUnlock(nabu_surface_lock);
+	return ok;
+}
+
+NabuSurface *
+nabu_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	NabuSurface *s = nabu_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page(bytesPerRow * height);
+	s->memory = IOMemoryDescriptor::withPhysicalAddress(phys, s->allocSize, kIODirectionInOut);
+	s->mapCache = kIOMapWriteCombineCache;
+	if (s->memory == NULL || !nabu_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
+mach_port_name_t
+nabu_surface_port_in_task(NabuSurface *s, task_t task)
+{
+	mach_port_name_t name = 0;
+	IOUserClient::copyPortNameForObjectInTask(task, s, &name);
+	return name;
+}
+
+static uint32_t
+nabu_dict_u32(OSDictionary *dict, const char *key, uint32_t def)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, dict->getObject(key));
+	return n != NULL ? n->unsigned32BitValue() : def;
+}
+
+static uint32_t
+nabu_div_up(uint32_t a, uint32_t b)
+{
+	return b > 1 ? (a + b - 1) / b : a;
+}
+
+static uint32_t
+nabu_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	uint64_t row = (uint64_t)nabu_div_up(width, ew) * bpe;
+	return (uint32_t)((row + NABU_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(NABU_SURFACE_ROW_ALIGN - 1));
+}
+
+/* Geometry from the creation properties (IOSurface.h keys). */
+static IOReturn
+nabu_surface_layout(NabuSurface *s, OSDictionary *props)
+{
+	uint64_t end;
+
+	s->width = nabu_dict_u32(props, "IOSurfaceWidth", 0);
+	s->height = nabu_dict_u32(props, "IOSurfaceHeight", 0);
+	s->bytesPerElement = (uint16_t)nabu_dict_u32(props, "IOSurfaceBytesPerElement", 4);
+	s->elementWidth = (uint8_t)nabu_dict_u32(props, "IOSurfaceElementWidth", 1);
+	s->elementHeight = (uint8_t)nabu_dict_u32(props, "IOSurfaceElementHeight", 1);
+	s->pixelFormat = nabu_dict_u32(props, "IOSurfacePixelFormat", 0);
+	s->cacheMode = nabu_dict_u32(props, "IOSurfaceCacheMode", 0);
+	s->offset = nabu_dict_u32(props, "IOSurfaceOffset", 0);
+	if (s->width > NABU_SURFACE_MAX_DIM || s->height > NABU_SURFACE_MAX_DIM ||
+	    s->bytesPerElement > 64 || s->elementWidth == 0 || s->elementHeight == 0) {
+		return kIOReturnBadArgument;
+	}
+	s->bytesPerRow = nabu_dict_u32(props, "IOSurfaceBytesPerRow",
+	    nabu_row_bytes(s->width, s->elementWidth, s->bytesPerElement));
+	if (s->bytesPerRow < (uint64_t)nabu_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
+		return kIOReturnBadArgument;
+	}
+	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * nabu_div_up(s->height, s->elementHeight);
+
+	OSArray *planes = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	s->planeCount = 0;
+	if (planes != NULL) {
+		uint64_t next = s->offset;
+		if (planes->getCount() > NABU_SURFACE_MAX_PLANES) {
+			return kIOReturnBadArgument;
+		}
+		for (unsigned int i = 0; i < planes->getCount(); i++) {
+			OSDictionary *pd = OSDynamicCast(OSDictionary, planes->getObject(i));
+			struct nabu_surface_plane *p = &s->planes[i];
+			if (pd == NULL) {
+				return kIOReturnBadArgument;
+			}
+			p->width = nabu_dict_u32(pd, "IOSurfacePlaneWidth", s->width);
+			p->height = nabu_dict_u32(pd, "IOSurfacePlaneHeight", s->height);
+			p->bytesPerElement = (uint16_t)nabu_dict_u32(pd, "IOSurfacePlaneBytesPerElement", 1);
+			p->elementWidth = (uint8_t)nabu_dict_u32(pd, "IOSurfacePlaneElementWidth", 1);
+			p->elementHeight = (uint8_t)nabu_dict_u32(pd, "IOSurfacePlaneElementHeight", 1);
+			if (p->width > NABU_SURFACE_MAX_DIM || p->height > NABU_SURFACE_MAX_DIM ||
+			    p->bytesPerElement > 64 || p->elementWidth == 0 || p->elementHeight == 0) {
+				return kIOReturnBadArgument;
+			}
+			p->bytesPerRow = nabu_dict_u32(pd, "IOSurfacePlaneBytesPerRow",
+			    nabu_row_bytes(p->width, p->elementWidth, p->bytesPerElement));
+			p->offset = nabu_dict_u32(pd, "IOSurfacePlaneOffset", (uint32_t)next);
+			p->size = nabu_dict_u32(pd, "IOSurfacePlaneSize",
+			    p->bytesPerRow * nabu_div_up(p->height, p->elementHeight));
+			next = round_page((uint64_t)p->offset + p->size);
+			if ((uint64_t)p->offset + p->size > end) {
+				end = (uint64_t)p->offset + p->size;
+			}
+		}
+		s->planeCount = planes->getCount();
+	}
+
+	uint64_t alloc = nabu_dict_u32(props, "IOSurfaceAllocSize", 0);
+	if (alloc < end) {
+		alloc = end;
+	}
+	alloc = round_page(alloc);
+	if (alloc == 0 || alloc > NABU_SURFACE_MAX_ALLOC) {
+		return kIOReturnNoMemory;
+	}
+	s->allocSize = (uint32_t)alloc;
+	return kIOReturnSuccess;
+}
+
+/* Per-client mapping of one surface. */
+class NabuSurfaceRef : public OSObject {
+	OSDeclareDefaultStructors(NabuSurfaceRef);
+
+public:
+	NabuSurface *surface;
+	IOMemoryMap  *data;
+	IOMemoryMap  *state;
+	uint32_t      count;
+
+	bool init() APPLE_KEXT_OVERRIDE { return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NabuSurfaceRef, OSObject);
+
+void
+NabuSurfaceRef::free()
+{
+	OSSafeReleaseNULL(data);
+	OSSafeReleaseNULL(state);
+	if (surface != NULL) {
+		nabu_surface_put(surface);
+		surface->release();
+		surface = NULL;
+	}
+	OSObject::free();
+}
+
+class IOCoreSurfaceRoot : public IOService {
+	OSDeclareDefaultStructors(IOCoreSurfaceRoot);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOCoreSurfaceRoot, IOService);
+
+bool
+IOCoreSurfaceRoot::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	nabu_surface_init_lock();
+	setProperty(kIOUserClientClassKey, "IOSurfaceRootUserClient");
+	registerService();
+	IOLog("NABU SURF: IOCoreSurfaceRoot registered\n");
+	return true;
+}
+
+class IOSurfaceRootUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOSurfaceRootUserClient);
+
+	task_t   fTask;
+	IOLock  *fLock;
+	OSArray *fRefs;
+
+	NabuSurfaceRef *findRef(uint32_t id, unsigned int *index);
+	IOReturn addRef(NabuSurface *s, NabuSurfaceRef **refOut);
+	IOReturn returnSurface(NabuSurface *s, IOExternalMethodArguments *args);
+	IOReturn create(IOExternalMethodArguments *args);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	IOExternalTrap *getTargetAndTrapForIndex(IOService **targetP, UInt32 index) APPLE_KEXT_OVERRIDE;
+
+	IOReturn trapUseCount(void *id, void *category, void *, void *, void *, void *);
+	IOReturn trapLock(void *id, void *options, void *seedOut, void *, void *, void *);
+	IOReturn trapUnlock(void *id, void *options, void *seedOut, void *, void *, void *);
+	IOReturn trapRelease(void *id, void *, void *, void *, void *, void *);
+};
+
+OSDefineMetaClassAndStructors(IOSurfaceRootUserClient, IOUserClient);
+
+static uint64_t nabu_surf_logged;      /* selectors / traps already logged (< 64) */
+
+static void
+nabu_surf_log_once(const char *what, uint32_t n)
+{
+	uint32_t bit = (what[0] == 't' ? 48 : 0) + n;
+	if (bit >= 64 || (nabu_surf_logged & (1ULL << bit))) {
+		return;
+	}
+	nabu_surf_logged |= 1ULL << bit;
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("NABU SURF: %s %s %u\n", name, what, n);
+}
+
+bool
+IOSurfaceRootUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fRefs = OSArray::withCapacity(16);
+	return fLock != NULL && fRefs != NULL;
+}
+
+void
+IOSurfaceRootUserClient::free()
+{
+	OSSafeReleaseNULL(fRefs);
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+IOSurfaceRootUserClient::clientClose(void)
+{
+	IOLockLock(fLock);
+	fRefs->flushCollection();
+	IOLockUnlock(fLock);
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Lock held. */
+NabuSurfaceRef *
+IOSurfaceRootUserClient::findRef(uint32_t id, unsigned int *index)
+{
+	for (unsigned int i = 0; i < fRefs->getCount(); i++) {
+		NabuSurfaceRef *ref = (NabuSurfaceRef *)fRefs->getObject(i);
+		if (ref->surface->id == id) {
+			if (index != NULL) {
+				*index = i;
+			}
+			return ref;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Count one more create/lookup of s by this client, mapping it into the
+ * task the first time. Takes over the caller's user count on s.
+ */
+IOReturn
+IOSurfaceRootUserClient::addRef(NabuSurface *s, NabuSurfaceRef **refOut)
+{
+	IOLockLock(fLock);
+	NabuSurfaceRef *ref = findRef(s->id, NULL);
+	if (ref != NULL && ref->surface == s) {
+		ref->count++;
+		IOLockUnlock(fLock);
+		nabu_surface_put(s);
+		*refOut = ref;
+		return kIOReturnSuccess;
+	}
+	IOLockUnlock(fLock);
+
+	ref = OSTypeAlloc(NabuSurfaceRef);
+	if (ref == NULL || !ref->init()) {
+		OSSafeReleaseNULL(ref);
+		nabu_surface_put(s);
+		return kIOReturnNoMemory;
+	}
+	s->retain();
+	ref->surface = s;
+	ref->count = 1;
+	ref->data = s->memory->createMappingInTask(fTask, 0, kIOMapAnywhere | s->mapCache);
+	ref->state = s->state->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapReadOnly);
+	if (ref->data == NULL || ref->state == NULL) {
+		ref->release();
+		return kIOReturnVMError;
+	}
+	IOLockLock(fLock);
+	NabuSurfaceRef *raced = findRef(s->id, NULL);
+	if (raced != NULL && raced->surface == s) {
+		/* Another thread mapped it meanwhile: count there, drop ours. */
+		raced->count++;
+		IOLockUnlock(fLock);
+		ref->release();
+		*refOut = raced;
+		return kIOReturnSuccess;
+	}
+	fRefs->setObject(ref);
+	IOLockUnlock(fLock);
+	ref->release();         /* fRefs holds it */
+	*refOut = ref;
+	return kIOReturnSuccess;
+}
+
+static void
+put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	memcpy(p + off, &v, 4);
+}
+
+static void
+put64(uint8_t *p, uint32_t off, uint64_t v)
+{
+	memcpy(p + off, &v, 8);
+}
+
+/* IOSurface.framework's lock result (copied to IOSurfaceClient + 0x68). */
+static void
+nabu_surface_fill_result(NabuSurface *s, NabuSurfaceRef *ref, uint8_t *out)
+{
+	bzero(out, NABU_SURFACE_RESULT_SIZE);
+	put64(out, 0x00, ref->data->getAddress());
+	put64(out, 0x08, ref->state->getAddress());
+	put64(out, 0x10, ref->state->getAddress() + NABU_SURFACE_TIMESTAMPS);
+	put32(out, 0x18, s->id);
+	put32(out, 0x1c, s->allocSize);
+	put32(out, 0x20, s->width);
+	put32(out, 0x24, s->height);
+	put32(out, 0x28, s->bytesPerRow);
+	put32(out, 0x2c, s->offset);
+	put32(out, 0x30, s->pixelFormat);
+	put32(out, 0x34, s->allocSize);
+	put32(out, 0x38, s->planeCount);
+	memcpy(out + 0x40, &s->bytesPerElement, 2);
+	out[0x42] = s->elementWidth;
+	out[0x43] = s->elementHeight;
+	put32(out, 0x44, s->cacheMode);
+	put32(out, 0x50, s->parentID);
+	put32(out, 0x54, 1);
+	for (uint32_t i = 0; i < s->planeCount; i++) {
+		uint8_t *p = out + 0x68 + i * 0x80;
+		const struct nabu_surface_plane *pl = &s->planes[i];
+		put32(p, 0x00, pl->width);
+		put32(p, 0x04, pl->height);
+		put32(p, 0x08, pl->bytesPerRow);
+		put32(p, 0x0c, pl->offset);
+		put32(p, 0x14, pl->size);
+		memcpy(p + 0x18, &pl->bytesPerElement, 2);
+		p[0x1a] = pl->elementWidth;
+		p[0x1b] = pl->elementHeight;
+	}
+}
+
+static IOReturn
+nabu_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Map s for this client and answer with its lock result. Takes s's user count. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(NabuSurface *s, IOExternalMethodArguments *args)
+{
+	NabuSurfaceRef *ref = NULL;
+	IOReturn ret = addRef(s, &ref);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	uint8_t *out = (uint8_t *)IOMallocZeroData(NABU_SURFACE_RESULT_SIZE);
+	if (out == NULL) {
+		ret = kIOReturnNoMemory;
+	} else {
+		nabu_surface_fill_result(s, ref, out);
+		ret = nabu_struct_out(args, out, NABU_SURFACE_RESULT_SIZE);
+		IOFreeData(out, NABU_SURFACE_RESULT_SIZE);
+	}
+	if (ret != kIOReturnSuccess) {
+		/* The caller never learns the id: undo this create/lookup. */
+		trapRelease((void *)(uintptr_t)s->id, NULL, NULL, NULL, NULL, NULL);
+	}
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
+{
+	const char *buf = (const char *)args->structureInput;
+	uint32_t len = args->structureInputSize;
+	char *copy = NULL;
+	IOReturn ret;
+
+	if (args->structureInputDescriptor != NULL) {
+		len = (uint32_t)args->structureInputDescriptor->getLength();
+		if (len == 0 || len > NABU_SURFACE_MAX_PROPS) {
+			return kIOReturnBadArgument;
+		}
+		copy = (char *)IOMallocData(len);
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		args->structureInputDescriptor->readBytes(0, copy, len);
+		buf = copy;
+	}
+	OSObject *obj = (buf != NULL && len > 0) ? OSUnserializeXML(buf, len) : NULL;
+	if (copy != NULL) {
+		IOFreeData(copy, len);
+	}
+	OSDictionary *props = OSDynamicCast(OSDictionary, obj);
+	if (props == NULL) {
+		OSSafeReleaseNULL(obj);
+		IOLog("NABU SURF: create: bad property dictionary (%u bytes)\n", len);
+		return kIOReturnBadArgument;
+	}
+
+	NabuSurface *s = nabu_surface_alloc();
+	if (s == NULL) {
+		props->release();
+		return kIOReturnNoMemory;
+	}
+	s->parentID = args->scalarInputCount > 0 ? (uint32_t)args->scalarInput[0] : 0;
+	ret = nabu_surface_layout(s, props);
+	if (ret == kIOReturnSuccess) {
+		IOBufferMemoryDescriptor *mem = NULL;
+		if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&nabu_surface_wired) +
+		    s->allocSize <= NABU_SURFACE_WIRED_MAX) {
+			mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+			    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+		}
+		if (mem == NULL) {
+			OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&nabu_surface_wired);
+			ret = kIOReturnNoMemory;
+		} else {
+			bzero(mem->getBytesNoCopy(), s->allocSize);
+			s->memory = mem;
+			s->mapCache = kIOMapDefaultCache;
+			if (!nabu_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		}
+	}
+	if (ret != kIOReturnSuccess || nabu_surface_creates_logged < 64) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		nabu_surface_creates_logged++;
+		IOLog("NABU SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u -> 0x%x\n",
+		    name, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
+		    s->bytesPerRow, s->planeCount, s->allocSize, props->getCount(), ret);
+	}
+	props->release();
+	if (ret != kIOReturnSuccess) {
+		s->release();
+		return ret;
+	}
+	ret = returnSurface(s, args);   /* takes the creator's user count */
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	uint64_t arg0 = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kNabuSurfaceLimits: {
+		uint8_t limits[0x18] = { 0 };
+		put32(limits, 0x0, NABU_SURFACE_ROW_ALIGN - 1);
+		put32(limits, 0x4, NABU_SURFACE_ROW_ALIGN - 1);
+		limits[0x16] = 1;
+		nabu_surf_log_once("sel", selector);
+		return nabu_struct_out(args, limits, sizeof(limits));
+	}
+	case kNabuSurfaceCreate:
+		return create(args);
+	case kNabuSurfaceLookup: {
+		NabuSurface *s = nabu_surface_copy((uint32_t)arg0);
+		IOReturn ret = kIOReturnNotFound;
+		if (s != NULL) {
+			ret = nabu_surface_get(s) ? returnSurface(s, args) : kIOReturnNotFound;
+			s->release();
+		}
+		nabu_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kNabuSurfaceLookupFromPort: {
+		OSObject *obj = NULL;
+		IOReturn ret = IOUserClient::copyObjectForPortNameInTask(fTask, (mach_port_name_t)arg0, &obj);
+		NabuSurface *s = OSDynamicCast(NabuSurface, obj);
+		if (ret == kIOReturnSuccess) {
+			ret = (s != NULL && nabu_surface_get(s)) ? returnSurface(s, args) : kIOReturnBadArgument;
+		}
+		OSSafeReleaseNULL(obj);
+		nabu_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kNabuSurfaceCreatePort: {
+		NabuSurface *s = nabu_surface_copy((uint32_t)arg0);
+		if (s == NULL || args->scalarOutputCount < 1) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		args->scalarOutput[0] = nabu_surface_port_in_task(s, fTask);
+		args->scalarOutputCount = 1;
+		s->release();
+		nabu_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+	default:
+		/* Values, notifications, ownership, timestamps...: accept and ignore. */
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+		if (args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		nabu_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
+    void *, void *, void *, void *)
+{
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+nabu_surface_seed_out(NabuSurface *s, void *seedOut, bool bump)
+{
+	uint32_t seed = bump ? OSIncrementAtomic((volatile SInt32 *)nabu_surface_seed(s)) + 1 :
+	    *nabu_surface_seed(s);
+	if (seedOut != NULL && copyout(&seed, (user_addr_t)seedOut, sizeof(seed)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return kIOReturnSuccess;
+}
+
+/* Retained surface this client created or looked up, or NULL. */
+static NabuSurface *
+nabu_surface_held(IOLock *lock, OSArray *refs, uint32_t id)
+{
+	NabuSurface *s = NULL;
+	IOLockLock(lock);
+	for (unsigned int i = 0; i < refs->getCount(); i++) {
+		NabuSurfaceRef *ref = (NabuSurfaceRef *)refs->getObject(i);
+		if (ref->surface->id == id) {
+			s = ref->surface;
+			s->retain();
+			break;
+		}
+	}
+	IOLockUnlock(lock);
+	return s;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOut,
+    void *, void *, void *)
+{
+	NabuSurface *s = nabu_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = nabu_surface_seed_out(s, seedOut, false);
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void *id, void *options, void *seedOut,
+    void *, void *, void *)
+{
+	NabuSurface *s = nabu_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = nabu_surface_seed_out(s, seedOut,
+	    !((uintptr_t)options & kIOSurfaceLockReadOnly));
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, void *)
+{
+	unsigned int index;
+	IOLockLock(fLock);
+	NabuSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, &index);
+	if (ref != NULL && --ref->count == 0) {
+		fRefs->removeObject(index);     /* unmaps and drops the user count */
+	}
+	IOLockUnlock(fLock);
+	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+static IOExternalTrap nabu_surface_traps[] = {
+	[kNabuSurfaceTrapIncrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUseCount },
+	[kNabuSurfaceTrapDecrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUseCount },
+	[kNabuSurfaceTrapLock]          = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapLock },
+	[kNabuSurfaceTrapUnlock]        = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUnlock },
+	[kNabuSurfaceTrapRelease]       = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+	[kNabuSurfaceTrapReleaseFailed] = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+};
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService **targetP, UInt32 index)
+{
+	if (index >= sizeof(nabu_surface_traps) / sizeof(nabu_surface_traps[0])) {
+		nabu_surf_log_once("trap", index);
+		return NULL;
+	}
+	nabu_surf_log_once("trap", index);
+	*targetP = this;
+	return &nabu_surface_traps[index];
+}
