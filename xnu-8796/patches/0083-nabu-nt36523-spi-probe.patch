+static void
+nbu_pin(unsigned pin, unsigned func, unsigned pull, unsigned drive,
+    int output, int level)
+{
+	uint32_t ctl_off = NABU_TLMM_GPIO(pin);
+	uint32_t io_off = NABU_TLMM_IO(pin);
+	uint32_t cfg;
+
+	if (!ts.tlmm) {
+		return;
+	}
+	if (output) {
+		uint32_t io = nbu_rd(ts.tlmm, io_off);
+		io = (io & ~2u) | (level ? 2u : 0u);
+		nbu_wr(ts.tlmm, io_off, io);
+	}
+	cfg = nbu_rd(ts.tlmm, ctl_off);
+	cfg &= ~0x3ffu;
+	cfg |= ((func & 0xfu) << 2) | (pull & 3u) | ((drive & 7u) << 6) |
+	    (output ? 0x200u : 0u);
+	nbu_wr(ts.tlmm, ctl_off, cfg);
+}
