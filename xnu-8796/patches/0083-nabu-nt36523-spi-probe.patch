+static bool
+nbu_probe_chip(void)
+{
+	uint8_t id[6] = { 0 };
+	uint8_t fw[39];
+	struct nvt_info info;
+	int r;
+
+	/* Engineering reset, then the vendor bootloader reset. */
+	{
+		uint8_t v = 0x5a;
+		r = nvt_write_addr(&ts.bus, 0x7fff80u, &v, 1);
+		printf("NABU TOUCH: eng reset r=%d\n", r);
+	}
+	delay(1000);
+	{
+		uint8_t v = 0x69;
+		r = nvt_write_addr(&ts.bus, 0x3f0feu, &v, 1);
+		printf("NABU TOUCH: bootloader reset r=%d\n", r);
+	}
+	delay(5000);
+	{
+		uint8_t v = 0;
+		r = nvt_write_addr(&ts.bus, 0x3f310u, &v, 1);
+		printf("NABU TOUCH: fast-read disable r=%d\n", r);
+	}
+	delay(5000);
+
+	r = nbu_read_trim(0x3f004u, id);
+	if (r != 0 || !nvt_match_nt36523(id)) {
+		r = nbu_read_trim(0x1f64eu, id);
+	}
+	if (r != 0 || !nvt_match_nt36523(id)) {
+		printf("NABU TOUCH: no NT36523 trim id; irq=%#x status=%#x tx=%#x rx=%#x\n",
+		    nbu_rd(ts.se, NABU_SE_IRQ_STATUS),
+		    nbu_rd(ts.se, NABU_SE_STATUS),
+		    nbu_rd(ts.se, NABU_SE_TX_COUNT),
+		    nbu_rd(ts.se, NABU_SE_RX_COUNT));
+		return false;
+	}
+	printf("NABU TOUCH: NT36523 identified\n");
+
+	r = nvt_read_addr(&ts.bus, 0x2fe78u, fw, sizeof(fw));
+	printf("NABU TOUCH: fwinfo r=%d\n", r);
+	if (r == 0) {
+		(void)nvt_parse_fwinfo(fw, sizeof(fw), &info);
+		printf("NABU TOUCH: fw=%u/%u valid=%d x_num=%u y_num=%u max=%ux%u buttons=%u\n",
+		    info.fw_ver, info.fw_type, info.valid, info.x_num,
+		    info.y_num, info.max_x, info.max_y, info.max_buttons);
+	}
 	return true;
 }
 
