+static bool
+nbu_geni_init(void)
+{
+	int r;
+
+	memset(&ts.spi, 0, sizeof(ts.spi));
+	ts.spi.se.ctx = (void *)ts.se;
+	ts.spi.se.rd = nbu_se_rd;
+	ts.spi.se.wr = nbu_se_wr;
+	ts.spi.se.delay_us = nbu_delay_us;
+	ts.spi.wrapper.ctx = (void *)ts.qup;
+	ts.spi.wrapper.rd = (uint32_t (*)(void *, uint32_t))nbu_se_rd;
+	ts.spi.wrapper.wr = nbu_se_wr;
+	ts.spi.poll_limit = 200000;
+	ts.spi.poll_only = 1;
+
+	r = geni_spi_read_info(&ts.spi);
+	printf("NABU TOUCH: geni info r=%d fw=%#x proto=%u fifo_dis=%d depth=%u width=%u qup=%#x\n",
+	    r, ts.spi.info.fw_revision, ts.spi.info.protocol,
+	    ts.spi.info.fifo_disabled, ts.spi.info.tx_fifo_depth,
+	    ts.spi.info.fifo_width_bits, ts.spi.info.qup_hw_version);
+	if (r != 0) {
+		return false;
+	}
+	if (ts.spi.info.protocol != GENI_PROTO_SPI) {
+		printf("NABU TOUCH: SE18 is not in SPI protocol mode\n");
+		return false;
+	}
+	if (ts.spi.info.tx_fifo_depth < 4 || ts.spi.info.fifo_width_bits != 32) {
+		printf("NABU TOUCH: unexpected FIFO geometry\n");
+		return false;
+	}
+
+	r = geni_spi_init(&ts.spi);
+	printf("NABU TOUCH: geni init=%d status=%#x\n", r,
+	    nbu_rd(ts.se, NABU_SE_STATUS));
+	if (r != 0) {
+		return false;
+	}
+	geni_spi_setup(&ts.spi, 0, 0);
+	r = geni_spi_set_clock(&ts.spi, 9600000, 19200000, 0);
+	printf("NABU TOUCH: geni clock=%d clk_sel=%#x mclk=%#x\n", r,
+	    nbu_rd(ts.se, 0x7c), nbu_rd(ts.se, 0x48));
+	return r == 0;
