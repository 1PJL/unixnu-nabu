+ * Bring-up fallback: the iPadOS renderer has produced pixels in a
+ * 1668x2224 BGRA surface, but its SwapEnd carries no layer ids.  Present
+ * the latest probed surface, letterboxed to the 1600x2560 panel.
+ */
+void
+AppleCLCD::present_fallback(void)
+{
+	uint32_t id = nabu_surface_bgra_hint_id();
+	if (id == 0) {
+		return;
+	}
+	NabuSurface *s = nabu_surface_copy(id);
+	if (s == NULL) {
+		return;
+	}
+	if (s == fSurface ||
+	    s->pixelFormat != 0x42475241 || s->bytesPerElement != 4 ||
+	    s->width == 0 || s->height == 0 || s->memory == NULL) {
+		s->release();
+		return;
+	}
+
+	uint32_t sw = s->width, sh = s->height, sbpr = s->bytesPerRow;
+	uintptr_t src = s->kernelAddress();
+	uint64_t src_len = s->memory->getLength();
+	uint32_t dw = fWidth;
+	uint32_t dh = (uint32_t)(((uint64_t)sh * dw) / sw);
+	uint32_t off = 0;
+	uint32_t scaled_w = dw;
+	uint32_t crop_x = 0;
+	if (fCrop) {
+		/* Aspect-fill: scale to panel height, crop the sides. */
+		dh = fHeight;
+		scaled_w = (uint32_t)(((uint64_t)sw * fHeight + sh - 1) / sh);
+		if (scaled_w < dw) {
+			scaled_w = dw;
+		}
+		crop_x = (scaled_w - dw) / 2;
+	} else if (fStretch) {
+		dh = fHeight;
+	} else {
+		if (dh > fHeight) {
+			dh = fHeight;
+		}
+		off = (fHeight - dh) / 2;
+	}
+
+	if (src == 0 || s->offset + (uint64_t)sh * sbpr > src_len) {
+		s->release();
+		return;
+	}
+
+	/* Black letterbox. */
+	for (uint32_t y = 0; y < off; y++) {
+		memset((void *)(fPixels + (uint64_t)y * fRowBytes), 0,
+		    (size_t)fWidth * 4);
+	}
+	for (uint32_t y = off + dh; y < fHeight; y++) {
+		memset((void *)(fPixels + (uint64_t)y * fRowBytes), 0,
+		    (size_t)fWidth * 4);
+	}
